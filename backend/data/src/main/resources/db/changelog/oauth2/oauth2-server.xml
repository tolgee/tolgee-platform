<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet author="jancizmar" id="oauth2-authorization-drop-spring-authorization-server-tables">
        <comment>
            Earlier builds of this feature persisted grants in the Spring Authorization Server schema. Nothing released
            ever wrote it, so it is dropped rather than migrated.
        </comment>
        <sql dbms="postgresql" splitStatements="true">
            DROP TABLE IF EXISTS oauth2_authorization_consent;
            DROP TABLE IF EXISTS oauth2_authorization;
        </sql>
    </changeSet>

    <changeSet author="jancizmar" id="oauth2-authorization">
        <createTable tableName="oauth2_authorization">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="oauth2_authorizationPK"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="user_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="redirect_uri" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="client_state" type="VARCHAR(2000)"/>
            <column name="code_challenge" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_scopes" type="VARCHAR(4000)">
                <constraints nullable="false"/>
            </column>
            <column name="granted_scopes" type="VARCHAR(4000)"/>
            <column name="project_hint" type="BIGINT"/>
            <column name="project_selection" type="VARCHAR(255)"/>
            <column name="consent_state" type="VARCHAR(255)"/>
            <column name="code_hash" type="VARCHAR(255)"/>
            <column name="code_expires_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="code_used_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="access_token_hash" type="VARCHAR(255)"/>
            <column name="access_token_issued_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="access_token_expires_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="refresh_token_hash" type="VARCHAR(255)"/>
            <column name="refresh_token_expires_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>
        <addUniqueConstraint columnNames="consent_state" constraintName="oauth2_authorization_consent_state_unique"
                             tableName="oauth2_authorization"/>
        <addUniqueConstraint columnNames="code_hash" constraintName="oauth2_authorization_code_hash_unique"
                             tableName="oauth2_authorization"/>
        <addUniqueConstraint columnNames="access_token_hash" constraintName="oauth2_authorization_access_token_hash_unique"
                             tableName="oauth2_authorization"/>
        <addUniqueConstraint columnNames="refresh_token_hash" constraintName="oauth2_authorization_refresh_token_hash_unique"
                             tableName="oauth2_authorization"/>
        <createIndex indexName="oauth2_authorization_user_account_id_idx" tableName="oauth2_authorization">
            <column name="user_account_id"/>
        </createIndex>
        <addForeignKeyConstraint baseColumnNames="user_account_id" baseTableName="oauth2_authorization"
                                 constraintName="oauth2_authorization_user_account_fk" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id" referencedTableName="user_account"
                                 validate="true"/>
    </changeSet>
</databaseChangeLog>
