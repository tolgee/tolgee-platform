# Copy to .env.local (gitignored) and fill in. create-tolgee-app already wrote
# a .env.local for you; this file documents every variable the app reads.

# Tolgee instance this app talks to. Its origin is also baked into the frontend
# bundle at build time, and the iframe accepts the context token from that origin
# only — so rebuild after changing it.
TOLGEE_URL=http://localhost:8718

# Origin of Tolgee's web app — the page that frames this app. Production usually
# serves the web app and the API from one host, but a dev setup does not: the web
# app is on 3718 while the API is on 8718. Both origins are baked into the bundle,
# so set this whenever they differ or the iframe handshake is refused.
# TOLGEE_FRONTEND_URL=http://localhost:3718

# Ports the dev servers bind to. Vite serves the iframe, Express serves
# /manifest.json. Change both when running two apps side by side.
VITE_PORT=5180
SERVER_PORT=5181

# --- Dev tunnel --------------------------------------------------------------
# Tolgee fetches the manifest and loads the iframe from its own server, so both
# have to be reachable *from Tolgee*. When TOLGEE_URL is not localhost,
# `npm run dev` opens a Cloudflare quick tunnel and registers the app with that
# public URL — required against staging or production, which run with
# tolgee.apps.allow-local-addresses disabled and reject localhost URLs.
#
# Set this to skip the tunnel and use http://localhost:<VITE_PORT> instead
# (only useful when Tolgee can reach this machine some other way).
# TOLGEE_DEV_TUNNEL=none

# --- Self-registration (connect mode "auto") ---------------------------------
# The server registers itself on boot when this is set. The secret is
# server-wide and comes from the Tolgee administrator — Tolgee's configuration
# holds only its hash (tolgee.apps.registration-secret-hash), so the plaintext
# lives here alone.
# TOLGEE_APP_REGISTRATION_TOKEN=
#
# Slug of the organization the app registers into, which owns it. Unset, the
# app registers into the server's initial organization. A server admin can
# later offer it to every organization from the owner's Apps page.
# TOLGEE_APP_ORGANIZATION=

# --- App credentials (machine-to-machine) ------------------------------------
# Leave these unset in development. Registration stores the credentials Tolgee
# issues in .tolgee-dev/install.json (gitignored) and the SDK reads them back,
# so there is nothing to copy.
#
# Set them only where the app is deployed and the secrets are injected by the
# platform. Setting either one makes the SDK ignore the stored file entirely,
# so set both or neither.
# TOLGEE_APP_CLIENT_ID=
# TOLGEE_APP_CLIENT_SECRET=

# --- Lifecycle deliveries ----------------------------------------------------
# The secret Tolgee signs its lifecycle deliveries (credentials, installs,
# rotations) with. It authenticates nothing towards Tolgee and is never sent
# anywhere — holding it is what proves an incoming delivery really is Tolgee.
#
# Leave unset in development: it arrives with the registration delivery and is
# stored in .tolgee-dev/install.json. Set it in a deployment, to the value
# Tolgee showed when the app was registered, so no first delivery has to be
# taken on trust.
# TOLGEE_APP_WEBHOOK_SECRET=
