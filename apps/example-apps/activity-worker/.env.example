# Copy to .env.local and fill in what you need. .env.local is git-ignored.

# --- Tolgee instance ------------------------------------------------------
# Base URL of the Tolgee server this app talks to. Its origin is also baked into
# the frontend bundle at build time, and the iframe accepts the context token
# from that origin only — so rebuild after changing it.
# Default: http://localhost:8718
# TOLGEE_URL=http://localhost:8718

# Origin of Tolgee's web app — the page that frames this app. Production usually
# serves the web app and the API from one host, but a dev setup does not: the web
# app is on 3718 while the API is on 8718. Both origins are baked into the bundle,
# so set this whenever they differ or the iframe handshake is refused.
# TOLGEE_FRONTEND_URL=http://localhost:3718

# --- Ports ----------------------------------------------------------------
# Deliberately not 5180/5181 — those are keys-showcase's, so both example apps
# can run at once.
# Vite dev server (serves the iframe page). Default: 5182
# VITE_PORT=5182
# Express server (serves /manifest.json and /api/feed). Default: 5183
# SERVER_PORT=5183

# --- URLs -----------------------------------------------------------------
# Origin the iframe assets are served from; goes into the manifest's baseUrl.
# Default: the dev tunnel's URL, or http://localhost:<VITE_PORT> without one.
# Set this when you deploy the built app.
# APP_BASE_URL=

# URL Tolgee fetches the manifest from — must be reachable from the Tolgee
# server. Default: the dev tunnel's URL, or
# http://localhost:<SERVER_PORT>/manifest.json without one.
# APP_MANIFEST_URL=

# --- Dev tunnel -----------------------------------------------------------
# Tolgee fetches the manifest and loads the iframe from its own server, so both
# must be reachable *from Tolgee*. When TOLGEE_URL is not localhost,
# `npm run dev` opens a Cloudflare quick tunnel and registers the app with that
# public URL — required against staging or production, which run with
# tolgee.apps.allow-local-addresses disabled and reject localhost URLs.
#
# Set this to skip the tunnel and use http://localhost:<VITE_PORT> instead.
# TOLGEE_DEV_TUNNEL=none

# --- Auto-connect mode ----------------------------------------------------
# This app is backend-driven: without credentials it has nothing to poll Tolgee
# with, so set this to have it self-register on boot. Must match
# App registration tokens -> Generate; the app is owned by that organization.
#
# TOLGEE_APP_REGISTRATION_TOKEN=
#

# --- App credentials (machine-to-machine) ---------------------------------
# Leave these unset in development. Registering the app stores its credentials
# in .tolgee-dev/install.json (gitignored) and the SDK reads them from there.
#
# Set them only where the app is deployed and the secrets are injected by the
# platform. Setting either one makes the SDK ignore the stored file entirely,
# so set both or neither.
# TOLGEE_APP_CLIENT_ID=
# TOLGEE_APP_CLIENT_SECRET=

# --- Polling --------------------------------------------------------------
# The alpha has no push channel, so everything below is a poll against Tolgee.
# Lower values react faster and cost more requests; see the README.
#
# How often each watched project's activity is re-read. Default: 15000
# ACTIVITY_POLL_INTERVAL_MS=15000
#
# How often the app re-asks Tolgee which projects it is enabled for, so a newly
# enabled project starts being watched without a restart. Default: 60000
# INSTALLATIONS_REFRESH_INTERVAL_MS=60000
#
# Activity revisions read per project per poll. Default: 20
# ACTIVITY_PAGE_SIZE=20
#
# Translation changes kept in memory per project. Default: 50
# ACTIVITY_FEED_SIZE=50
